# Rename this file to .env and put your real key here.
# Never paste this key inside your HTML or JavaScript front end.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Recommended model can be changed later from Anthropic Console/docs.
CLAUDE_MODEL=claude-sonnet-4-6

# Local server port
PORT=3000

# For local same-origin use, keep this empty.
# For separate frontend/backend deployment, set your frontend URL, example:
# ALLOWED_ORIGIN=https://yourdomain.com
ALLOWED_ORIGIN=
